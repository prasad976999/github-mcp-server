# Create a fine-grained token at https://github.com/settings/personal-access-tokens
# Read-only access to public repos is enough to start.
GITHUB_TOKEN=github_pat_xxx

# Write tools (create_issue) are off unless you turn them on. They also need a token
# with "Issues: Read and write" permission on the repositories you want to change.
# GITHUB_ALLOW_WRITES=true
