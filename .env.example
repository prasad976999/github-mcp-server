# Create a fine-grained token at https://github.com/settings/personal-access-tokens
# Read-only access to public repos is enough to start.
GITHUB_TOKEN=github_pat_xxx

# Write tools (create_issue) are off unless you turn them on. They also need a token
# with "Issues: Read and write" permission on the repositories you want to change.
# GITHUB_ALLOW_WRITES=true

# HTTP mode (used by the Docker image). The default is stdio, where the MCP client starts
# the server itself and none of these matter.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Clients must send "Authorization: Bearer <this>". Required for any host but 127.0.0.1.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN=
# Extra Host header values to accept, comma-separated (e.g. mcp.internal:*).
# MCP_ALLOWED_HOSTS=
